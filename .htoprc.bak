################################################################################
# htop configuration file
################################################################################

htop_version=3.2.1
config_reader_min_version=3

fields=0 3 18 46 47 38 39 40 114 111 49 6 48 2 1

########################################

account_guest_in_cpu_meter=0
all_branches_collapsed=0
color_scheme=0
cpu_count_from_one=1
degree_fahrenheit=0
delay=10
detailed_cpu_time=1
enable_mouse=1
find_comm_in_cmdline=1
header_layout=two_50_50
header_margin=0
hide_function_bar=0
hide_kernel_threads=1
hide_userland_threads=1
highlight_base_name=1
highlight_changes=0
highlight_changes_delay_secs=5
highlight_deleted_exe=1
highlight_megabytes=1
highlight_threads=1
screen_tabs=1
shadow_other_users=0
show_cpu_frequency=0
show_cpu_temperature=1
show_cpu_usage=1
show_merged_command=0
show_program_path=1
show_thread_names=0
sort_direction=-1
sort_key=46
strip_exe_from_cmdline=1
tree_sort_direction=1
tree_sort_key=0
tree_view=0
tree_view_always_by_pid=0
update_process_names=1

########################################

column_meters_0=Battery CPU Memory Swap AllCPUs2
column_meter_modes_0=1 1 1 1 1
column_meters_1=Hostname System DateTime Uptime LoadAverage Tasks Memory NetworkIO DiskIO
column_meter_modes_1=2 2 2 2 2 2 2 2 2

########################################

screen:Main=PID PPID NICE PERCENT_CPU PERCENT_MEM M_VIRT M_RESIDENT M_SHARE IO_PRIORITY IO_RATE TIME TTY USER STATE Command
.all_branches_collapsed=0
.sort_direction=-1
.sort_key=PERCENT_CPU
.tree_sort_direction=1
.tree_sort_key=PID
.tree_view=0
.tree_view_always_by_pid=0

screen:I/O=PID PPID NICE IO_PRIORITY IO_RATE IO_READ_RATE IO_WRITE_RATE RBYTES WBYTES CNCLWB RCHAR WCHAR SYSCR SYSCW TIME TTY USER STATE Command
.all_branches_collapsed=0
.sort_direction=-1
.sort_key=IO_RATE
.tree_sort_direction=1
.tree_sort_key=PID
.tree_view=0
.tree_view_always_by_pid=0

################################################################################
# end of file
################################################################################
